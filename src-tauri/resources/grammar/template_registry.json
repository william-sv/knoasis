{
  "_说明": "每个学科一个详情模板。前端按 sections 顺序渲染；type=fields 渲染单值字段组，type=list 渲染多值列表，type=paragraph 渲染整段 pre-wrap 文本（view.paragraphs[key]），type=images 渲染图解网格（view.images，空则整节隐藏）。",
  "ko_grammar": {
    "label": "韩语语法",
    "headwordLabel": "语法",
    "sections": [
      {
        "key": "meta",
        "label": "语法信息",
        "type": "meta",
        "_note": "头部元数据条由 GrammarDetail 挂载 DetailMeta 渲染（pos/speechLevel/level/aliases/sources/category/id），本段为占位声明，DetailSections 跳过"
      },
      {
        "key": "explanation",
        "label": "语法释义",
        "type": "paragraph",
        "fieldKey": "explanation"
      },
      {
        "key": "connections_grouped",
        "label": "语法用法详解（活用 / 接续规则）",
        "type": "connections_grouped",
        "_note": "按 attachesTo 分 动词/形容词/名词 三块；每块含 接续公式 + 形态实现(realizations) + 实例 + 语义 + 时态"
      },
      {
        "key": "examples",
        "label": "例句",
        "type": "examples"
      },
      {
        "key": "common_errors",
        "label": "易错点",
        "type": "common_errors"
      },
      {
        "key": "similar",
        "label": "近似语法",
        "type": "similar"
      },
      {
        "key": "antonyms",
        "label": "相反语法",
        "type": "antonyms",
        "_note": "模块已具备：运行时读 view.antonyms，无值/缺字段则整节隐藏，有值则按 headword+difference 显示。v11 当前无相反语法数据字段。"
      },
      {
        "key": "senses",
        "label": "义项",
        "type": "list",
        "itemFields": [
          {
            "key": "sense",
            "label": "义项"
          },
          {
            "key": "usage",
            "label": "说明与例证"
          }
        ]
      },
      {
        "key": "related",
        "label": "相关语法",
        "type": "related",
        "_note": "v11 related 字符串数组：内部 ko… 已映射为 app uid（可点击跳转），外部 ext:概念 原样展示。v11 无独立「相反语法」字段，本段覆盖近似/相关关联"
      }
    ]
  },
