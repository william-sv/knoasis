{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://cdn.jsdelivr.net/**" },
        { "url": "https://raw.githubusercontent.com/**" },
        { "url": "https://ghproxy.com/**" },
        { "url": "https://raw.gitmirror.com/**" }
      ]
    },
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] }
  ]
}
